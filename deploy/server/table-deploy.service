[Unit]
Description=TABLE static site deploy hook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=table-deploy
Group=table-deploy
EnvironmentFile=/etc/table-deploy.env
ExecStart=/usr/bin/python3 /opt/table-deploy-hook/deploy-hook.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/table-deploy
UMask=0022

[Install]
WantedBy=multi-user.target